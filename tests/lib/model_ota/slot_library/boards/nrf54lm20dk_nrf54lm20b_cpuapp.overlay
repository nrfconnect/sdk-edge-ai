&axon {
	status = "okay";
};

/* The test does not use MCUboot, so the secondary image slot is free for the model partitions. */
/delete-node/ &slot1_partition;

&cpuapp_rram {
	partitions {
		model_first_storage: partition@102000 {
			compatible = "zephyr,mapped-partition";
			label = "model_first_storage";
			reg = <0x102000 DT_SIZE_K(16)>;
		};

		model_second_storage: partition@106000 {
			compatible = "zephyr,mapped-partition";
			label = "model_second_storage";
			reg = <0x106000 DT_SIZE_K(16)>;
		};
	};
};
