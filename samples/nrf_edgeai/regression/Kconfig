menu "nRF Edge AI Regression sample"

choice NRF_EDGEAI_REGRESSION_MODEL
	prompt "Regression model backend"
	default NRF_EDGEAI_REGRESSION_MODEL_AXON if SOC_NRF54LM20B
	default NRF_EDGEAI_REGRESSION_MODEL_NEUTON
	help
	  Select which model implementation to use for the air quality regression sample.
	  Neuton runs on CPU; Axon uses the NPU and is only available on nRF54L20 (nrf54lm20b).

config NRF_EDGEAI_REGRESSION_MODEL_NEUTON
	bool "Neuton (CPU)"
	help
	  Use the Neuton model. Works on all nRF Edge AI supported boards.

config NRF_EDGEAI_REGRESSION_MODEL_AXON
	bool "Axon (NPU)"
	depends on SOC_NRF54LM20B
	select NRF_AXON
	help
	  Use the Axon model. Only available on nRF54L20 (nrf54lm20b) with Axon NPU.

endchoice

config APP_MODEL_OTA
	bool "Load regression model from a separate flash partition (model-only OTA)"
	select FLASH
	select FLASH_MAP
	select CRC
	select MODEL_OTA
	select MODEL_OTA_SMP
	help
	  When enabled, this sample does not ship a compiled-in regression model.
	  At boot, the model is loaded and validated from the model_storage flash
	  partition instead - independently of the application image.

	  Set via sysbuild as SB_CONFIG_APP_MODEL_OTA (see sysbuild_model_ota.conf).

if APP_MODEL_OTA

config APP_MODEL_OTA_NEUTON
	def_bool y
	depends on NRF_EDGEAI_REGRESSION_MODEL_NEUTON
	select MODEL_OTA_NEUTON

config APP_MODEL_OTA_AXON
	def_bool y
	depends on NRF_EDGEAI_REGRESSION_MODEL_AXON
	select MODEL_OTA_AXON

endif # APP_MODEL_OTA

endmenu

source "Kconfig.zephyr"
