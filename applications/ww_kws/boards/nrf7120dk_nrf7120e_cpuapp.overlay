/*
 * Control output goes to UART21, which the board routes to the onboard debugger
 * (TX P1.08, RX P1.09). Pins and baud rate are inherited from the board files.
 */
/ {
	chosen {
		ncs,control-output-uart = &uart21;
	};
};

&uart21 {
	status = "okay";
};

&pinctrl {
	pdm20_default_alt: pdm20_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 4)>,
				<NRF_PSEL(PDM_DIN, 1, 5)>;
		};
	};
};

dmic_dev: &pdm20 {
	status = "okay";
	pinctrl-0 = <&pdm20_default_alt>;
	pinctrl-names = "default";
	clock-source = "PCLK32M";
};

&axon {
	status = "okay";
};
