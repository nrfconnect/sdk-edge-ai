;
; CDDL schema for the Edge AI observability CBOR wire format.
;
; obsv-payload is produced by nrf_edgeai_obsv_encode_cbor() for a single context.
; obsv-list is produced by nrf_edgeai_obsv_encode_list() and wraps one
; obsv-payload per registered context; it is the on-wire format for any transport
; (e.g. Memfault CDR, UART, BLE) that carries multi-model observability data.

obsv-list = [+ obsv-payload]

obsv-payload = {
    "format_version" : uint,    ; schema version; bumped on breaking changes
    "num_inferences" : uint,    ; inferences (PROBS stream) consumed since last reset
    "num_features"   : uint,    ; feature-vector updates (FEATURES stream) consumed
                                ; since last reset (a counter; NOT obsv-model.num_features)
    "model"          : obsv-model,
    "metrics"        : [* obsv-metric],
}

obsv-model = {
    "id"           : uint,      ; application-defined model identifier
    "num_classes"  : uint,      ; output class count the model produces
    "num_features" : uint,      ; input feature vector length; 0 if unused
    "version"      : uint,      ; application-defined model version
}

; One element per registered metric. Keys are abbreviated because this map
; repeats per metric; top-level keys use full words since they appear once.
obsv-metric = {
    "id" : uint,                ; nrf_edgeai_obsv_metric_id (on-wire id)
    "v"  : uint,                ; metric payload version (per metric_id)
    "d"  : [* [* uint]],        ; row-major num_rows x num_cols matrix
    ? "c" : [* [* uint]],       ; configuration the counters were gathered with, a
                                ; row-major matrix like "d"; omitted when the metric
                                ; reports none. Meaning and order are fixed per
                                ; (id, v), see below.
}

; Well-known metric id values. The schema does not constrain "id" to this set;
; unknown ids are allowed for forward compatibility. See
; enum nrf_edgeai_obsv_metric_id in nrf_edgeai_obsv_metrics.h.
;   1 = model certainty descriptor (3 x num_bins; per-inference certainty and
;       temporal stability over the output probability vector; rows:
;       0 normalized Shannon entropy H(p)/ln(N) histogram over [0, 1]
;         (uncertainty),
;       1 top-2 margin p_top1 - p_top2 histogram over [0, 1] (decisiveness),
;       2 stability counters [switches, comparisons, majority_frames,
;         confident_switches] zero-padded to num_bins, where
;         SwitchRate = switches / comparisons, majority_frames counts inferences
;         with p_top1 > 0.5, and confident_switches counts switches into a
;         p_top1 > 0.5 winner; majority_frames / confident_switches are present
;         only when num_bins >= 3 / 4)
;   2 = class predictions distribution (2*num_classes x num_bins; per-class output
;       picture over the probability vector; rows [0, num_classes) = probability
;       distribution (each class's predicted probability binned uniformly over
;       [0, 1]; every inference adds one sample to every row, so each sums to
;       num_inferences); rows [num_classes, 2*num_classes) = streak distribution
;       (per-class histogram of consecutive-argmax run lengths, binned uniformly
;       over [1, TOP] with lengths >= TOP in the top bin, recorded when a streak
;       ends with up to a configured flicker tolerance bridged; these rows do NOT
;       sum to num_inferences)
;       "c" = [[streak_top, streak_tol]] (1 x 2): the streak length saturating the top
;       streak bin, and the flicker tolerance in bridged frames)
;   3 = transition matrix (num_classes x num_classes)
;   4 = mel energy descriptor (4 x num_bins; per-frame stats over input mel
;       features, rows: 0 mean energy, 1 max energy, 2 dynamic range (q95-q05),
;       3 floor-bin ratio; features normalized to [0, 1] by a configured
;       percentile range [p01, p99], all rows histogrammed over [0, 1])
;       "c" = [[scale_p01_milli, scale_p99_milli]] (1 x 2): the p01 / p99
;       normalization bounds in thousandths of a feature unit, each the
;       two's-complement bits of an int32 (read values >= 2^31 as negative))
;   5 = mel spectral descriptor (8 x num_bins; per-frame scale-invariant shape
;       stats over input mel features, rows: 0 low ratio, 1 mid ratio, 2 high
;       ratio, 3 centroid, 4 spread, 5 entropy, 6 flatness, 7 contrast; all
;       normalized to [0, 1])
