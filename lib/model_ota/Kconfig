config MODEL_OTA_TESTING
	bool "Model OTA testing mode (empty header pad, no MCUboot)"
	depends on FLASH && CRC && XIP
	depends on !BOOTLOADER_MCUBOOT
	help
	  Development and sample use only. Model partitions reserve a 32-byte header
	  slot at the partition base (zeroed, not MCUboot-signed) and link the model
	  payload at partition_base + 32, matching the production layout without
	  requiring MCUboot or imgtool signing. Flash the emitted *_model_partition.hex
	  files directly (for example multi_model with overlay-ota.conf).

menuconfig MODEL_OTA
	bool "Model-only OTA update (linked partition images)"
	depends on BOOTLOADER_MCUBOOT || MODEL_OTA_TESTING
	depends on FLASH && CRC && XIP
	select MCUBOOT_BOOTUTIL_LIB if BOOTLOADER_MCUBOOT
	help
	  Library that loads and validates NN models from dedicated flash partitions at
	  runtime, independently of the application image. Each model partition reserves
	  a 32-byte header slot at the partition base; the linked model payload follows
	  at partition_base + 32. With MCUboot, imgtool signs the payload as a separate
	  updateable image. In testing mode the header slot is left empty (zeroed).
	  Neuton and Axon models are built as self-contained partition images with a
	  header holding a DIRECT pointer to the model. Model pointers are used directly
	  in zephyr,mapped-partition storage (XIP). Enable CONFIG_FLASH and CONFIG_CRC
	  in the application's prj.conf.

if MODEL_OTA

config MODEL_OTA_NEUTON
	bool "Enable the Neuton model image loader"
	depends on NRF_EDGEAI
	help
	  Builds model_image_neuton.c and model_image_load_neuton(). OTA-wired models are compiled
	  via model_ota_edgeai_neuton_model(), which compiles
	  lib/model_ota/src/model_ota_edgeai_neuton_wired.c once per solution with -D defines
	  (includes generated nrf_edgeai_user_model.c and defines
	  nrf_edgeai_load_user_model_<SOLUTION_ID>()), then drops each wired model's payload from
	  its static library by archive-scoped linker /DISCARD/ rules.
	  Build-time macro contract: model_ota_stub_macros.h.
	  See lib/model_ota/cmake/model_ota_edgeai_neuton.cmake and include/model_ota/model_image.h.

config MODEL_OTA_AXON
	bool "Enable the Axon model image loader"
	depends on NRF_AXON
	help
	  Builds model_image_axon.c and model_image_load_axon(). Edge AI Lab solutions with an
	  Axon backend use model_ota_edgeai_axon_model(): only the compiled Axon model is
	  partition-loaded; the nrf_edgeai_t wrapper stays in the app. Raw Axon models are built
	  as self-contained partition images and wired to the application with one
	  model_ota_axon_model() declaration.
	  See lib/model_ota/cmake/model_ota_axon.cmake and include/model_ota/model_image.h.

config MODEL_OTA_LOG_LEVEL
	int "Log level for the model_image module"
	default 3
	range 0 4
	help
	  0 = off, 1 = err, 2 = wrn, 3 = inf, 4 = dbg.

config MODEL_OTA_GUARD_DRAIN_TIMEOUT_MS
	int "Timeout to wait for inference before rejecting model update (ms)"
	default 2000
	range 100 30000
	help
	  When a model update starts, the library waits this long for in-flight
	  model access to finish before rejecting the operation with -EBUSY or
	  MGMT_ERR_EBUSY. Use a value below typical SMP client command timeouts
	  (often 10-20 s) so the client receives a rejection before it times out.

config MODEL_OTA_SMP
	bool "Coordinate inference with MCUboot SMP model uploads"
	depends on BOOTLOADER_MCUBOOT
	depends on MCUMGR
	depends on MCUMGR_MGMT_NOTIFICATION_HOOKS
	depends on MCUMGR_GRP_IMG
	depends on MCUMGR_GRP_IMG_UPLOAD_CHECK_HOOK
	depends on MCUMGR_GRP_IMG_STATUS_HOOKS
	help
	  Register MCUMGR image-upload hooks that pause inference while a registered
	  MCUboot updateable model image is uploaded over SMP. After upload completes,
	  inference stays blocked until the device resets and reloads the new model.

if MODEL_OTA_SMP

config MODEL_OTA_SMP_MAX_SLOTS
	int "Maximum number of MCUboot model image slots"
	default 4
	range 1 16
	help
	  Upper bound on entries passed to model_ota_smp_register().

config MODEL_OTA_SMP_DRAIN_RETRY_WINDOW_MS
	int "Window to keep inference blocked for an upload retry (ms)"
	default 30000
	range 1000 600000
	help
	  When the first upload chunk is rejected because in-flight model access did
	  not finish within CONFIG_MODEL_OTA_GUARD_DRAIN_TIMEOUT_MS, inference stays
	  blocked for this long so that readers drain and a repeated upload attempt
	  is accepted without waiting again. If the client does not retry within the
	  window, or the retry still finds model access in flight, the block is
	  lifted and inference continues on the unchanged model. Size this to cover
	  the client's retry delay after an MGMT_ERR_EBUSY response.

endif # MODEL_OTA_SMP

endif # MODEL_OTA
