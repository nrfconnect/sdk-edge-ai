menuconfig MODEL_OTA
	bool "Model-only OTA update (linked partition images)"
	depends on FLASH && FLASH_MAP && CRC
	help
	  Proof-of-concept library that loads and validates NN models from dedicated flash
	  partitions at runtime, independently of the application image, and without relying on
	  MCUboot for integrity checking or transport. Neuton and Axon models are built as
	  self-contained, linked partition images (descriptor and data linked AT the partition
	  base, with a header holding a DIRECT pointer to the model). Model pointers are used
	  directly in the memory-mapped partition (XIP) - there is no RAM-copy loading mode.
	  Enable CONFIG_FLASH, CONFIG_FLASH_MAP and CONFIG_CRC in the application's prj.conf.

if MODEL_OTA

config MODEL_OTA_NEUTON
	bool "Enable the Neuton model image loader"
	depends on NRF_EDGEAI
	help
	  Builds model_image_neuton.c and model_image_load_neuton(). OTA-wired models are compiled
	  via model_ota_neuton_wire(), which configure_file()s lib/model_ota/src/model_ota_neuton_wired.c.in
	  into a per-model wired translation unit (includes generated nrf_edgeai_user_model.c and
	  defines nrf_edgeai_load_user_model_<SOLUTION_ID>()), then drops each wired model's payload from its static library by archive-scoped linker /DISCARD/ rules.
	  Build-time macro contract: model_ota_stub_macros.h.
	  See lib/model_ota/cmake/model_ota_neuton_image.cmake,
	  lib/model_ota/cmake/model_ota_neuton.cmake and include/model_ota/model_image.h.

config MODEL_OTA_AXON
	bool "Enable the Axon model image loader"
	depends on NRF_AXON
	help
	  Builds model_image_axon.c and model_image_load_axon(). Pure Axon models are built as
	  self-contained partition images and wired to the application with one
	  model_ota_axon_model() declaration. Edge AI Lab solutions with an Axon backend use
	  model_ota_axon_edgeai_wire() (lib/model_ota/cmake/model_ota_axon_edgeai.cmake): only
	  the compiled Axon model is partition-loaded; the nrf_edgeai_t wrapper stays in the app.
	  See lib/model_ota/cmake/model_ota_axon.cmake and include/model_ota/model_image.h.

config MODEL_OTA_LOG_LEVEL
	int "Log level for the model_image module"
	default 3
	range 0 4
	help
	  0 = off, 1 = err, 2 = wrn, 3 = inf, 4 = dbg.

config MODEL_OTA_SMP
	bool "Coordinate inference with MCUboot SMP model uploads"
	depends on BOOTLOADER_MCUBOOT
	depends on MCUBOOT_BOOTUTIL_LIB
	depends on MCUMGR
	depends on MCUMGR_MGMT_NOTIFICATION_HOOKS
	depends on MCUMGR_GRP_IMG
	depends on MCUMGR_GRP_IMG_UPLOAD_CHECK_HOOK
	depends on MCUMGR_GRP_IMG_STATUS_HOOKS
	help
	  Register MCUMGR image-upload hooks that pause inference while a registered
	  MCUboot updateable model image is uploaded over SMP. After upload completes,
	  inference stays blocked until the device resets and reloads the new model.

if MODEL_OTA_SMP

config MODEL_OTA_SMP_MAX_SLOTS
	int "Maximum number of MCUboot model image slots"
	default 4
	range 1 16
	help
	  Upper bound on entries passed to model_ota_smp_init().

config MODEL_OTA_SMP_UPLOAD_LOCK_TIMEOUT_MS
	int "Timeout to wait for inference before rejecting model SMP upload (ms)"
	default 60000
	range 1000 300000
	help
	  When a model image upload starts, the library waits this long for in-flight
	  inference to finish before rejecting the upload with MGMT_ERR_EBUSY.

endif # MODEL_OTA_SMP

endif # MODEL_OTA
