/*
 * Computed here rather than in the generated model_ota/axon/<target>.h, because only this
 * translation unit has the solution source in scope. The generated header deliberately omits a
 * contract hash for an Edge AI Lab solution, so there is no pure-Axon value to pick up by
 * mistake.
 */
#define MODEL_OTA_AXON_EDGEAI_CONTRACT_HASH                                                        \
	MODEL_OTA_CONTRACT_HASH_AXON_EDGEAI(MODEL_OTA_AXON_@AXON_TOKEN@_IMAGE_BASE,                \
					    MODEL_OTA_SOLUTION_CONTRACT_ARGS)

nrf_edgeai_t *nrf_edgeai_load_user_model_@SOLUTION_ID@(const uint8_t *partition_addr,
							 size_t partition_size)
{
	MODEL_OTA_ASSERT_MAPPED_PARTITION_ADDR(@PARTITION_NODELABEL@, partition_addr);

	const nrf_axon_nn_compiled_model_s *model;
	const struct model_image_axon_expect expect = {
		.contract_hash = MODEL_OTA_AXON_EDGEAI_CONTRACT_HASH,
		.persistent_vars_cap = MODEL_OTA_AXON_@AXON_TOKEN@_PERSISTENT_VARS_CAP,
		.packed_output_cap = MODEL_OTA_AXON_@AXON_TOKEN@_PACKED_OUTPUT_BYTES,
		.binding_table = MODEL_OTA_AXON_@AXON_TOKEN@_KEEP_LABEL,
	};

	if (model_image_load_axon(partition_addr, partition_size, &expect, &model) != MODEL_IMAGE_OK) {
		return NULL;
	}

	if (model_image_bind_edgeai_params(partition_addr, &nrf_edgeai_) != MODEL_IMAGE_OK) {
		return NULL;
	}

	nrf_edgeai_.model.instance.p_void = (void *)model;

	return &nrf_edgeai_;
}
