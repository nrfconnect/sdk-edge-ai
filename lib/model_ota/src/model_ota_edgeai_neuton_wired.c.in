#include "model_ota_stub_macros.h"

#include <model_ota/model_contract.h>
#include <model_ota/model_image.h>
#include <model_ota/model_ota_edgeai.h>
#include <zephyr/sys/util.h>

#define MODEL_OTA_WIRED 1
#define MODEL_OTA_NEUTON_NEURONS_CAP     @NEURONS_CAP@

#include "nrf_edgeai_user_types.h"

/** OTA neuron scratch buffer (capacity = NEURONS_CAP at configure time). */
static nrf_user_neuron_t model_neurons_cap_[MODEL_OTA_NEUTON_NEURONS_CAP];

#include "@MODEL_SRC_BASENAME@"

#include "model_ota_scale_select.h"

#define MODEL_OTA_EDGEAI_NEUTON_CONTRACT_HASH                                                      \
	MODEL_OTA_CONTRACT_HASH_EDGEAI_NEUTON(NRF_MODEL_PARTITION_ADDR,                            \
					      MODEL_IMAGE_PARAMS_TYPE_OF(MODEL_PARAMS_TYPE),       \
					      MODEL_OTA_SOLUTION_CONTRACT_ARGS)

MODEL_OTA_BUILD_ASSERT_MAPPED_PARTITION(@PARTITION_NODELABEL@);

nrf_edgeai_t *nrf_edgeai_load_user_model_@SOLUTION_ID@(const uint8_t *partition_addr,
							 size_t partition_size)
{
	MODEL_OTA_ASSERT_MAPPED_PARTITION_ADDR(@PARTITION_NODELABEL@, partition_addr);

	(void)model_neurons_;

	const struct model_image_neuton_expect expect = {
		.params_type = MODEL_IMAGE_PARAMS_TYPE_OF(MODEL_PARAMS_TYPE),
		.neurons_cap = MODEL_OTA_NEUTON_NEURONS_CAP,
		.contract_hash = MODEL_OTA_EDGEAI_NEUTON_CONTRACT_HASH,
	};

	if (model_image_load_neuton(partition_addr, partition_size, &nrf_edgeai_, model_neurons_cap_,
				    ARRAY_SIZE(model_neurons_cap_), &expect) != MODEL_IMAGE_OK) {
		return NULL;
	}

	if (model_image_bind_edgeai_params(partition_addr, &nrf_edgeai_) != MODEL_IMAGE_OK) {
		return NULL;
	}

	return &nrf_edgeai_;
}
