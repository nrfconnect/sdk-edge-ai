menuconfig NRF_EDGEAI_OBSV_MEMFAULT
	bool "Memfault heartbeat transport for Edge AI Observability"
	depends on NRF_EDGEAI_OBSV
	depends on NRF_EDGEAI_OBSV_METRIC_MODEL_CERTAINTY_DESC
	depends on MEMFAULT || ZTEST
	help
	  Copies selected observability counters into application-defined Memfault
	  heartbeat metrics immediately before each heartbeat is serialized.

if NRF_EDGEAI_OBSV_MEMFAULT

config NRF_EDGEAI_OBSV_MEMFAULT_MAX_CONTEXTS
	int "Maximum number of observability contexts registered with Memfault"
	default 1
	range 1 8
	help
	  Upper bound on the number of nrf_edgeai_obsv_ctx_t instances that can
	  be registered via nrf_edgeai_obsv_memfault_init().

module = NRF_EDGEAI_OBSV_MEMFAULT
module-str = nrf_edgeai_obsv_mflt
source "subsys/logging/Kconfig.template.log_config"

endif # NRF_EDGEAI_OBSV_MEMFAULT
