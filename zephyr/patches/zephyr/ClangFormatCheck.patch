From 3a9fb14d9099e69a5dcdac9879e6d9cbd127408a Mon Sep 17 00:00:00 2001
From: Szymon Antkowiak <szymon.antkowiak@nordicsemi.no>
Date: Fri, 9 Oct 2026 07:53:45 +0200
Subject: [PATCH] scripts: ci: check_compliance: skip spurious removed-file
 diffs

When a file is listed in .clang-format-ignore, clang-format-diff will
report a full-file removal. Ignore those patches so it does not suggest
removing ignored file.

Signed-off-by: Szymon Antkowiak <szymon.antkowiak@nordicsemi.no>
---
 scripts/ci/check_compliance.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/scripts/ci/check_compliance.py b/scripts/ci/check_compliance.py
index 09eaeda71c6c..5c64b3c13703 100755
--- a/scripts/ci/check_compliance.py
+++ b/scripts/ci/check_compliance.py
@@ -474,6 +474,11 @@ def run(self):
             except subprocess.CalledProcessError as ex:
                 patchset = unidiff.PatchSet.from_string(ex.output, encoding="utf-8")
                 for patch in patchset:
+                    # .clang-format-ignore: clang-format skips the file (exit 0, empty stdout).
+                    # clang-format-diff diffs against that empty output, yielding a spurious
+                    # full-file removal diff; unidiff reports that as is_removed_file.
+                    if patch.is_removed_file:
+                        continue
                     self._process_patch_error(file, patch)
 
 
