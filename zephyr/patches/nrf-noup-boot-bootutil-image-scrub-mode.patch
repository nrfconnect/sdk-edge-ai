diff --git a/boot/bootutil/src/loader.c b/boot/bootutil/src/loader.c
index 3c79eb9c..be3b6906 100644
--- a/boot/bootutil/src/loader.c
+++ b/boot/bootutil/src/loader.c
@@ -1066,6 +1066,117 @@ static inline void sec_slot_cleanup_if_unusable(void)
 #endif /* defined(CONFIG_MCUBOOT_CLEANUP_UNUSABLE_SECONDARY) &&\
           defined(MCUBOOT_IS_SECOND_STAGE) || defined(CONFIG_SOC_NRF5340_CPUAPP) */
 
+#if defined(CONFIG_BOOT_OPTIONAL_IMAGES)
+/**
+ * Check whether an image may be invalid without blocking the boot.
+ *
+ * Image 0 is the image that MCUboot boots, so it is rejected here regardless of
+ * the configured mask.
+ *
+ * @param image_index Index of the image to check.
+ *
+ * @return true if the image is optional, false otherwise.
+ */
+static bool boot_image_is_optional(uint8_t image_index)
+{
+    if (image_index == 0) {
+        return false;
+    }
+
+    return (CONFIG_BOOT_OPTIONAL_IMAGES_MASK & (1UL << image_index)) != 0;
+}
+
+#if defined(CONFIG_BOOT_OPTIONAL_IMAGES_SCRUB)
+/**
+ * Check whether a location in a flash area still holds data.
+ *
+ * @param fap Flash area to inspect.
+ * @param off Offset within the flash area.
+ *
+ * @return true if the location is not in the erased state.
+ */
+static bool boot_region_has_data(const struct flash_area *fap, uint32_t off)
+{
+    uint32_t erased_word;
+    uint32_t first_word;
+
+    if (flash_area_read(fap, off, &first_word, sizeof(first_word)) != 0) {
+        /* The state cannot be determined, so assume a scrub is still needed. */
+        return true;
+    }
+
+    memset(&erased_word, flash_area_erased_val(fap), sizeof(erased_word));
+
+    return first_word != erased_word;
+}
+
+/**
+ * Scrub the primary slot of an optional image that failed validation.
+ *
+ * Only the first sector is scrubbed. Dropping the image header is what makes
+ * the application treat the partition as empty, and limiting the write to a
+ * single sector keeps the boot short for slots that may be large.
+ *
+ * The outcome is reported here rather than by the caller, so that a boot that
+ * finds the slot already scrubbed is not reported as having scrubbed it again.
+ *
+ * @param state Bootloader state, with BOOT_CURR_IMG set to the image to scrub.
+ */
+static void boot_scrub_optional_image(struct boot_loader_state *state)
+{
+    const struct flash_area *fap = BOOT_IMG_AREA(state, BOOT_SLOT_PRIMARY);
+    uint32_t off;
+    uint32_t size;
+    int rc;
+
+    if (fap == NULL) {
+        BOOT_LOG_ERR("Failed to scrub image %d: no flash area", BOOT_CURR_IMG(state));
+        return;
+    }
+
+    if (boot_img_num_sectors(state, BOOT_SLOT_PRIMARY) == 0) {
+        /* The sector layout is unknown, so the header cannot be mapped onto a
+         * sector; fall back to scrubbing the whole slot.
+         */
+        off = 0;
+        size = flash_area_get_size(fap);
+    } else {
+        off = boot_img_sector_off(state, BOOT_SLOT_PRIMARY, 0);
+        size = boot_img_sector_size(state, BOOT_SLOT_PRIMARY, 0);
+    }
+
+    if (!boot_region_has_data(fap, off)) {
+        /* Already scrubbed on an earlier boot; skip the write so that the
+         * memory is not rewritten on every reset.
+         */
+        return;
+    }
+
+    rc = boot_scramble_region(fap, off, size, false);
+    if (rc != 0) {
+        BOOT_LOG_ERR("Failed to scrub image %d: %d", BOOT_CURR_IMG(state), rc);
+    } else {
+        BOOT_LOG_INF("Scrubbed image %d in the primary slot", BOOT_CURR_IMG(state));
+    }
+}
+#endif /* CONFIG_BOOT_OPTIONAL_IMAGES_SCRUB */
+
+/**
+ * Report and scrub an optional image whose primary slot failed validation.
+ *
+ * @param state Bootloader state, with BOOT_CURR_IMG set to the failed image.
+ */
+static void boot_handle_invalid_optional_image(struct boot_loader_state *state)
+{
+    BOOT_LOG_ERR("Image %d in the primary slot is invalid; image is optional, continuing boot",
+                 BOOT_CURR_IMG(state));
+
+#if defined(CONFIG_BOOT_OPTIONAL_IMAGES_SCRUB)
+    boot_scrub_optional_image(state);
+#endif /* CONFIG_BOOT_OPTIONAL_IMAGES_SCRUB */
+}
+#endif /* CONFIG_BOOT_OPTIONAL_IMAGES */
+
 #ifdef CONFIG_MCUBOOT_UUID_CID
 /**
  * Read the image UUID from the TLV.
@@ -2593,6 +2704,17 @@ context_boot_go(struct boot_loader_state *state, struct boot_rsp *rsp)
             if (FIH_NOT_EQ(fih_rc, FIH_SUCCESS) ||
                 FIH_EQ(fih_rc, FIH_FAILURE) ||
                 FIH_EQ(fih_rc, FIH_NO_BOOTABLE_IMAGE)) {
+#if defined(CONFIG_BOOT_OPTIONAL_IMAGES)
+                if (boot_image_is_optional(BOOT_CURR_IMG(state))) {
+                    boot_handle_invalid_optional_image(state);
+                    /* The image is not booted and its data is not trusted, so
+                     * skip the rollback protection and shared data updates that
+                     * the rest of the iteration performs for a valid image.
+                     */
+                    ++fih_cnt;
+                    continue;
+                }
+#endif /* CONFIG_BOOT_OPTIONAL_IMAGES */
                 FIH_SET(fih_rc, FIH_FAILURE);
                 goto out;
             }
@@ -2606,6 +2728,13 @@ context_boot_go(struct boot_loader_state *state, struct boot_rsp *rsp)
             BOOT_LOG_ERR("bad image magic 0x%lx; Image=%u", (unsigned long)
                          BOOT_IMG(state, BOOT_SLOT_PRIMARY).hdr.ih_magic,
                          BOOT_CURR_IMG(state));
+#if defined(CONFIG_BOOT_OPTIONAL_IMAGES)
+            if (boot_image_is_optional(BOOT_CURR_IMG(state))) {
+                boot_handle_invalid_optional_image(state);
+                ++fih_cnt;
+                continue;
+            }
+#endif /* CONFIG_BOOT_OPTIONAL_IMAGES */
             rc = BOOT_EBADIMAGE;
             FIH_SET(fih_rc, FIH_FAILURE);
             goto out;
diff --git a/boot/zephyr/Kconfig b/boot/zephyr/Kconfig
index 8ed9c2e8..08f23daa 100644
--- a/boot/zephyr/Kconfig
+++ b/boot/zephyr/Kconfig
@@ -624,6 +624,41 @@ config BOOT_VALIDATE_SLOT0_ONCE
 	  low end devices with as a compromise lowering the security level.
 	  If unsure, leave at the default value.
 
+config BOOT_OPTIONAL_IMAGES
+	bool "Boot the application even if an optional image is invalid"
+	depends on UPDATEABLE_IMAGE_NUMBER > 1
+	depends on !BOOT_DIRECT_XIP && !BOOT_RAM_LOAD && !BOOT_FIRMWARE_LOADER
+	help
+	  If y, the images selected by BOOT_OPTIONAL_IMAGES_MASK are treated as
+	  optional. When such an image fails validation, the bootloader reports
+	  the failure and carries on booting image 0 instead of halting.
+
+	  Use this for images that hold data consumed by the application, such
+	  as a machine learning model, where a missing or corrupted image
+	  degrades functionality but must not stop the device from starting.
+
+	  Image 0 is the image that MCUboot boots, so it is always mandatory and
+	  is never affected by this option.
+
+config BOOT_OPTIONAL_IMAGES_MASK
+	hex "Bitmask of optional images"
+	depends on BOOT_OPTIONAL_IMAGES
+	default 0x0
+	help
+	  Bit N set marks image N as optional. Bit 0 is ignored because image 0
+	  must always be valid. For example, 0x2 marks image 1 as optional, and
+	  0x6 marks images 1 and 2 as optional.
+
+config BOOT_OPTIONAL_IMAGES_SCRUB
+	bool "Scrub an optional image that fails validation"
+	depends on BOOT_OPTIONAL_IMAGES
+	default y
+	help
+	  If y, the bootloader erases the first sector of the primary slot of an
+	  optional image that failed validation. Erasing the sector removes the
+	  image header, so the application sees the partition as empty rather
+	  than parsing content that MCUboot has rejected.
+
 config BOOT_PREFER_SWAP_OFFSET
 	bool "Prefer the newer swap offset algorithm"
 	default y if !$(dt_nodelabel_enabled,scratch_partition) && !SOC_FAMILY_STM32
